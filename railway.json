{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @kalndlord/api build",
    "watchPatterns": ["apps/api/**", "packages/shared/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "preDeployCommand": ["cd apps/api && pnpm exec prisma migrate deploy && node dist/seed.js --if-configured"],
    "startCommand": "node apps/api/dist/server.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
