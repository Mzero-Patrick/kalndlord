{
  "expo": {
    "name": "Kalndlord",
    "slug": "kalndlord",
    "scheme": "kalndlord",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "rw.kalndlord.app"
    },
    "android": {
      "package": "rw.kalndlord.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kalndlord uses your photos so you can add pictures of the places you list."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
