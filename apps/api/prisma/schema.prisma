generator client {
  provider = "prisma-client-js"
  // rhel-openssl-3.0.x is the engine Vercel's functions run on.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LANDLORD
  TENANT
}

enum Channel {
  PHONE
  EMAIL
}

model User {
  id              String    @id @default(cuid())
  fullName        String
  phone           String?   @unique
  email           String?   @unique
  passwordHash    String
  role            Role
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  verificationCodes VerificationCode[]
  properties        Property[]         @relation("PropertyLandlord")
  applications      Application[]
  tenantLeases      Lease[]            @relation("LeaseTenant")
  landlordLeases    Lease[]            @relation("LeaseLandlord")
  inquiries         Inquiry[]
  payments          Payment[]          @relation("PaymentTenant")
  recordedPayments  Payment[]          @relation("PaymentRecorder")
  sentNotices       Notice[]           @relation("NoticeSender")
  receivedNotices   Notice[]           @relation("NoticeRecipient")
  reportedIssues    Issue[]            @relation("IssueTenant")
  assignedIssues    Issue[]            @relation("IssueLandlord")
  issueUpdates      IssueUpdate[]
}

model VerificationCode {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     Channel
  destination String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

enum PropertyType {
  HOUSE
  APARTMENT
  ROOM
  WORKSHOP
  OFFICE
  SHOP
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  HIDDEN
}

model Property {
  id          String         @id @default(cuid())
  landlordId  String
  landlord    User           @relation("PropertyLandlord", fields: [landlordId], references: [id])
  title       String
  type        PropertyType
  description String
  district    String
  sector      String
  address     String?
  monthlyRent Int
  deposit     Int?
  sizeSqm     Int?
  bedrooms    Int?
  terms       String
  status      PropertyStatus @default(AVAILABLE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  photos       Photo[]
  applications Application[]
  leases       Lease[]
  inquiries    Inquiry[]
  issues       Issue[]

  @@index([status, district, type])
  @@index([landlordId])
}

model Photo {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  key        String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId, position])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id              String            @id @default(cuid())
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          User              @relation(fields: [tenantId], references: [id])
  message         String?
  moveInDate      DateTime?
  // The exact terms text the tenant accepted, kept even if the listing changes later.
  acceptedTerms   String
  termsAcceptedAt DateTime
  status          ApplicationStatus @default(PENDING)
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())

  @@index([propertyId, status])
  @@index([tenantId])
}

enum LeaseStatus {
  ACTIVE
  ENDED
}

model Lease {
  id            String      @id @default(cuid())
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id])
  tenantId      String
  tenant        User        @relation("LeaseTenant", fields: [tenantId], references: [id])
  landlordId    String
  landlord      User        @relation("LeaseLandlord", fields: [landlordId], references: [id])
  applicationId String      @unique
  monthlyRent   Int
  terms         String
  startDate     DateTime
  endDate       DateTime?
  status        LeaseStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())

  charges RentCharge[]
  issues  Issue[]

  @@index([tenantId])
  @@index([landlordId])
}

// Questions from the contact section: about a listing (goes to its landlord)
// or general (goes to the administrator).
model Inquiry {
  id         String    @id @default(cuid())
  fromId     String
  from       User      @relation(fields: [fromId], references: [id])
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  subject    String
  message    String
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([propertyId])
  @@index([fromId])
}

enum ChargeStatus {
  DUE
  PAID
}

// One month's rent for a lease. Created by the rent job; paid by one
// successful Payment.
model RentCharge {
  id            String       @id @default(cuid())
  leaseId       String
  lease         Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  period        String // "2026-10"
  amount        Int
  dueDate       DateTime
  status        ChargeStatus @default(DUE)
  paidAt        DateTime?
  // 0 none sent, 1 "due soon", 2 "due today", 3 "overdue".
  reminderStage Int          @default(0)
  createdAt     DateTime     @default(now())

  payments Payment[]

  @@unique([leaseId, period])
  @@index([status, dueDate])
}

enum PaymentMethod {
  MTN
  AIRTEL
  CARD
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model Payment {
  id           String         @id @default(cuid())
  chargeId     String
  charge       RentCharge     @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  // The tenant account the payment is recorded against.
  tenantId     String
  tenant       User           @relation("PaymentTenant", fields: [tenantId], references: [id])
  amount       Int
  method       PaymentMethod?
  provider     String // "flutterwave", "sandbox" or "manual"
  txRef        String         @unique
  providerRef  String?
  status       PaymentStatus  @default(PENDING)
  receiptNo    String?        @unique
  // Set when a landlord or the administrator records a cash payment.
  recordedById String?
  recordedBy   User?          @relation("PaymentRecorder", fields: [recordedById], references: [id])
  paidAt       DateTime?
  createdAt    DateTime       @default(now())

  @@index([tenantId])
  @@index([chargeId])
}

// A message from a landlord or the administrator to tenants.
model Notice {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("NoticeSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("NoticeRecipient", fields: [recipientId], references: [id])
  subject     String
  message     String
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

enum IssueKind {
  MAINTENANCE
  OTHER
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  DONE
}

// A tenant's report to their landlord: a repair, or any other issue about the
// rental or business. The landlord moves it from open to done.
model Issue {
  id         String      @id @default(cuid())
  leaseId    String
  lease      Lease       @relation(fields: [leaseId], references: [id])
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id])
  tenantId   String
  tenant     User        @relation("IssueTenant", fields: [tenantId], references: [id])
  landlordId String
  landlord   User        @relation("IssueLandlord", fields: [landlordId], references: [id])
  kind       IssueKind
  urgent     Boolean     @default(false)
  subject    String
  message    String
  status     IssueStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  photos  IssuePhoto[]
  updates IssueUpdate[]

  @@index([landlordId, status])
  @@index([tenantId, createdAt])
}

model IssuePhoto {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@index([issueId])
}

// A message on an issue, optionally changing its status.
model IssueUpdate {
  id        String       @id @default(cuid())
  issueId   String
  issue     Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  message   String?
  status    IssueStatus?
  createdAt DateTime     @default(now())

  @@index([issueId, createdAt])
}
