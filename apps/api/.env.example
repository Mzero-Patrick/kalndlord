DATABASE_URL="postgresql://kalndlord:kalndlord@localhost:5432/kalndlord"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Comma-separated origins allowed to call the API (web app).
CORS_ORIGINS="http://localhost:3000"
# Public address of this API (photo links point here) and where uploaded photos are kept.
PUBLIC_API_URL="http://localhost:4000"
UPLOAD_DIR="uploads"

# First administrator account, created by `pnpm --filter @kalndlord/api db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Administrator"

# SMS: "console" prints codes in the API log (development). "africastalking" sends real SMS.
SMS_PROVIDER="console"
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# Email: "console" prints in the API log. "smtp" sends real email.
EMAIL_PROVIDER="console"
SMTP_URL=""
EMAIL_FROM="Kalndlord <no-reply@example.com>"
