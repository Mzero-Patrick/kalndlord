DATABASE_URL="postgresql://kalndlord:kalndlord@localhost:5432/kalndlord"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Comma-separated origins allowed to call the API (web app).
CORS_ORIGINS="http://localhost:3000"
# Public address of this API (photo links point here) and where uploaded photos are kept.
PUBLIC_API_URL="http://localhost:4000"
UPLOAD_DIR="uploads"
# Production: keep photos in an S3-compatible bucket (Cloudflare R2, AWS S3) instead.
# STORAGE="s3"
# S3_BUCKET="kalndlord-photos"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://<public bucket address>"

# First administrator account, created by `pnpm --filter @kalndlord/api db:seed` (and on
# every deploy). An existing account keeps its password unless ADMIN_RESET_PASSWORD=true.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Administrator"

# SMS: "console" prints codes in the API log (development). "africastalking" sends real SMS.
SMS_PROVIDER="console"
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# Email: "console" prints in the API log. "smtp" sends real email.
EMAIL_PROVIDER="console"
SMTP_URL=""
EMAIL_FROM="Kalndlord <no-reply@example.com>"

# Payments: "sandbox" shows a test page instead of charging anyone (development).
# "flutterwave" takes real MTN MoMo, Airtel Money and card payments. "off" hides online
# payment until Flutterwave is ready; landlords can still record cash.
PAYMENT_PROVIDER="sandbox"
FLW_SECRET_KEY=""
# The "secret hash" set in the Flutterwave dashboard webhook settings.
FLW_WEBHOOK_HASH=""
# Comma-separated addresses the payment page may return to: the web app and the mobile app.
PAYMENT_REDIRECTS="http://localhost:3000/,kalndlord://,exp://"
# Minutes between runs of the rent job (monthly bills and reminders). 0 turns it off.
RENT_JOB_MINUTES=60
